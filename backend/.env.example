# Переменные среды задаются в PowerShell перед запуском. Это НЕ автоматически загружаемый .env.
# Для локальной сети (внимание: IP изменится, если изменится настройка DHCP):
TRUSTED_HOSTS=localhost,127.0.0.1,192.168.1.102
# После получения домена добавить его и исключить неизвестные Host.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_ASSETS_TOTAL_BYTES=1073741824
MAX_METADATA_TOTAL_BYTES=268435456
MAX_PROJECTS=5000
MAX_CARDS=10000
RETENTION_DAYS=30
